# Banco de dados PostgreSQL
DATABASE_URL=postgres://civiobra:civiobra@localhost:5432/civiobra
# Banco usado somente pelos testes automatizados (é recriado a cada execução)
DATABASE_URL_TESTE=postgres://civiobra:civiobra@localhost:5432/civiobra_test

# Opcional: número máximo de conexões por instância (padrão 3 em produção).
# DATABASE_CONEXOES=3

# Armazenamento de fotos e documentos (Supabase Storage, bucket privado).
# Sem estas duas, o sistema guarda os arquivos dentro do banco, como antes.
# A chave secreta fica só no servidor (Netlify); nunca no navegador.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# ARMAZENAMENTO_BUCKET=arquivos
# Só para desenvolvimento local: guarda os arquivos numa pasta.
# ARMAZENAMENTO_PASTA=./.arquivos
# Para o script `npm run mover-arquivos`: conexão de administrador do banco.
# ARMAZENAMENTO_DATABASE_URL=
